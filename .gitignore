# --- Mendix model source is COMMITTED -----------------------------------------
# TimeRegistration.mpr and mprcontents/ are the app itself, not build output.
# TimeRegistration/.gitignore covers the artifacts inside the project.

# --- Build artifacts ----------------------------------------------------------
bin/
dist/
build/
out/
*.exe
*.dll
*.so
*.dylib
*.test

# --- Mendix build / runtime output --------------------------------------------
deployment/
releases/
modeler-backup/
theme-cache/
.mendix-cache/
javasource/*/proxies/
javasource/system/
*.mpr.lock
*.mpr.bak
mprcontents/mprjournal*
*.mpk
*.mda
*.launch

# ...except the project's own widgets, which are inputs and not output. Nothing
# rebuilds them: they arrive with `mxcli new` or a `marketplace update`, and a
# clone without them does not build at all — 134 CE0462 "Could not find widget"
# errors, which is what this repo did until the marketplace sweep found it.
!TimeRegistration/widgets/
!TimeRegistration/widgets/**/*.mpk

# --- Local tool caches --------------------------------------------------------
.mxcli/
mxcli
mxcli.exe
node_modules/
.npm/
.cache/
.playwright/
__pycache__/

# --- Screenshots / scratch ----------------------------------------------------
# Verification screenshots taken during a build are throwaway; the ones under
# docs/ are documentation and belong in the repo.
screenshots/
!docs/screenshots/
tmp/
scratch/
*.png.tmp

# --- Editor / OS --------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Claude local overrides ---------------------------------------------------
.claude/settings.local.json
