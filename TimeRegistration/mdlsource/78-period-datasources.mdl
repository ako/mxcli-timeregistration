/**
 * TimeRegistration — period-aware reporting, part 3: the datasources
 *
 * Every report list was a page-level `database from Entity sort by SortOrder`
 * with no constraint. That was correct while one period had rows and wrong the
 * moment a second one did — the screens would have shown two months stacked on
 * top of each other. Each is replaced by a microflow scoped to the selected
 * period.
 *
 * These are datasource microflows, so they are not constrained by the entity
 * access rules (finding 19). None of them needs to be: a month-end summary is
 * firm-wide reporting, and the report pages are granted to Partner and
 * Administrator only. DS_MyMatters is the exception and scopes to the employee
 * itself, as it always did.
 */

/**
 * The period being reported on.
 *
 * Falls back to the earliest open period — the one the firm has to close next —
 * which is July 2026 in the seeded dataset.
 *
 * @returns the selected period
 */
create or modify microflow "TimeReg"."DS_SelectedPeriod" ()
returns "TimeReg"."Period" as $period
folder 'Datasources'
begin
  $employee = call microflow "TimeReg"."DS_CurrentEmployee" ();

  if $employee != empty then
    retrieve $selection from "TimeReg"."PeriodSelection"
      where ["TimeReg"."PeriodSelection_Employee" = $employee]
      limit 1;

    if $selection != empty then
      retrieve $selected from $selection/"TimeReg"."PeriodSelection_Period";
      if $selected != empty then
        return $selected;
      end if;
    end if;
  end if;

  retrieve $period from "TimeReg"."Period"
    where ["Status" = "TimeReg"."ENUM_PeriodStatus"."Open"]
    sort by TimeReg.Period.Year asc, TimeReg.Period.MonthNumber asc
    limit 1;
  return $period;
end;
/

/**
 * The period the firm has to close next.
 *
 * Now that navigating forward can open a new period, "the open one" has to mean
 * the earliest open one rather than whichever the database returned first.
 *
 * @returns the earliest open period
 */
create or modify microflow "TimeReg"."DS_CurrentPeriod" ()
returns "TimeReg"."Period" as $period
folder 'Datasources'
begin
  retrieve $period from "TimeReg"."Period"
    where ["Status" = "TimeReg"."ENUM_PeriodStatus"."Open"]
    sort by TimeReg.Period.Year asc, TimeReg.Period.MonthNumber asc
    limit 1;
  return $period;
end;
/

/**
 * The firm-wide KPI snapshot for the period being reported on.
 *
 * @returns the period statistics
 */
create or modify microflow "TimeReg"."DS_CurrentPeriodStat" ()
returns "TimeReg"."PeriodStat" as $stat
folder 'Datasources'
begin
  $period = call microflow "TimeReg"."DS_SelectedPeriod" ();
  retrieve $stat from "TimeReg"."PeriodStat"
    where ["TimeReg"."PeriodStat_Period" = $period]
    limit 1;
  return $stat;
end;
/

/**
 * The matters the signed-in fee earner booked time to in the selected period.
 *
 * @returns this employee's per-matter slice
 */
create or modify microflow "TimeReg"."DS_MyMatters" ()
returns list of "TimeReg"."MatterMonthSummary" as $rows
folder 'Datasources'
begin
  $employee = call microflow "TimeReg"."DS_CurrentEmployee" ();
  $period = call microflow "TimeReg"."DS_SelectedPeriod" ();

  retrieve $rows from "TimeReg"."MatterMonthSummary"
    where ["TimeReg"."MatterMonthSummary_Employee" = $employee
       and "TimeReg"."MatterMonthSummary_Period" = $period]
    sort by TimeReg.MatterMonthSummary.SortOrder asc;
  return $rows;
end;
/

/**
 * The firm's largest matters in the selected period.
 *
 * Firm-wide rows are the ones flagged as such — an employee-scoped row is that
 * person's slice, not the matter total.
 *
 * @returns the top matters
 */
create or modify microflow "TimeReg"."DS_TopMatters" ()
returns list of "TimeReg"."MatterMonthSummary" as $rows
folder 'Datasources'
begin
  $period = call microflow "TimeReg"."DS_SelectedPeriod" ();
  retrieve $rows from "TimeReg"."MatterMonthSummary"
    where ["IsFirmWide" = true
       and "TimeReg"."MatterMonthSummary_Period" = $period]
    sort by TimeReg.MatterMonthSummary.SortOrder asc;
  return $rows;
end;
/

/**
 * Approved time by client, for the per-customer report.
 *
 * @returns the client rows of the selected period
 */
create or modify microflow "TimeReg"."DS_PeriodClients" ()
returns list of "TimeReg"."ClientMonthSummary" as $rows
folder 'Datasources'
begin
  $period = call microflow "TimeReg"."DS_SelectedPeriod" ();
  retrieve $rows from "TimeReg"."ClientMonthSummary"
    where ["TimeReg"."ClientMonthSummary_Period" = $period]
    sort by TimeReg.ClientMonthSummary.SortOrder asc;
  return $rows;
end;
/

