/**
 * The realisation trend leading up to the selected period.
 *
 * Trend points belong to the period they were measured in, so this is the one
 * report list that deliberately reads more than the selected month: it shows
 * the twelve points up to and including it.
 *
 * @returns the trend points, oldest first
 */
create or modify microflow "TimeReg"."DS_PeriodTrend" ()
returns list of "TimeReg"."TrendPoint" as $rows
folder 'Datasources'
begin
  $period = call microflow "TimeReg"."DS_SelectedPeriod" ();
  retrieve $rows from "TimeReg"."TrendPoint"
    where ["TimeReg"."TrendPoint_Period" = $period]
    sort by TimeReg.TrendPoint.SortOrder asc;
  return $rows;
end;
/

