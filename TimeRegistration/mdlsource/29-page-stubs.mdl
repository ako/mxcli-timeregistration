/**
 * Page stubs.
 *
 * The real pages cross-reference each other (every screen has a Log time
 * button), so they are declared first and then replaced with their content.
 */

create or replace page "TimeReg"."WeekTimesheet" (
  Title: 'WeekTimesheet',
  Layout: Atlas_Core.Atlas_Default,
  Folder: 'Time'
)
{
  container stubWeekTimesheet (Class: 'vdh-page') {
    dynamictext stubWeekTimesheetText (Content: 'WeekTimesheet')
  }
}
/

