/**
 * Attributes in service of correcting recorded time.
 *
 * The approval task's second button has always read "Return with note", and
 * ACT_ReturnWeek has always written an audit line saying the week was returned
 * with a note — but there was nowhere to put one and nothing captured one. The
 * fee earner got a week back with no indication of what was wrong with it.
 * ReturnNote is that note, stored on the week it concerns.
 */
ALTER ENTITY "TimeReg"."Timesheet" ADD ATTRIBUTE IF NOT EXISTS "ReturnNote": string(500);
/

/**
 * The money captions on an entry, which still have to be precomputed.
 *
 * Rate and AmountValue are Decimals, and bound directly they render as `287` and
 * `717.5` where every other money figure in the app reads `€ 287` and `€ 718`.
 * A `format` block gets the precision right but not the separators: groupDigits
 * follows the runtime's en_US locale and produces `9,142` where the design wants
 * `9.142`, so the swap still happens in the microflow (as
 * ACT_RecalculateTimesheet does). Switching the runtime to nl_NL is not the way
 * out — it would render hours as `2,50`, which the design does not use.
 */
ALTER ENTITY "TimeReg"."TimeEntry" ADD ATTRIBUTE IF NOT EXISTS "RateLabel": string(20);
/
ALTER ENTITY "TimeReg"."TimeEntry" ADD ATTRIBUTE IF NOT EXISTS "ValueLabel": string(20);
/

/**
 * The two date captions, on the other hand, are gone.
 *
 * "Mon 20 Jul" on the week's entry list and "20 Jul 18:10" on the edit form are
 * both `dateFormat: Custom` with the pattern the design asks for, set at the
 * widget. Nothing has to write them, so nothing can write them wrong — and
 * DS_WeekEntries no longer backfills a caption onto every row it reads.
 */
ALTER ENTITY "TimeReg"."TimeEntry" DROP ATTRIBUTE IF EXISTS "EntryDateLabel";
/
ALTER ENTITY "TimeReg"."TimeEntry" DROP ATTRIBUTE IF EXISTS "RecordedLabel";
/
