/**
 * Display labels.
 *
 * The design formats every figure the Dutch way — "268.410", "842,0", "96,2%".
 * The runtime's locale is en_US, so the formatted form is stored alongside the
 * value rather than derived per widget. The numeric attribute stays the source
 * of truth; the label is what the dense report columns render.
 */
ALTER ENTITY "TimeReg"."ClientMonthSummary" ADD ATTRIBUTE IF NOT EXISTS "HoursLabel": string(16);
/
